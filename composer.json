{
	"name": "trk/processwire-react",
	"description": "Shared React 19 + Inertia v3 + Tailwind CSS v4 runtime, admin shell, form controls, media studio, rich text editor, interactive data viewports, and optional Workspace Hub for ProcessWire.",
	"type": "pw-module",
	"license": "MIT",
	"keywords": [
		"processwire",
		"react",
		"inertia",
		"tailwindcss",
		"design-system",
		"ui",
		"viewports",
		"forms",
		"media",
		"tiptap",
		"icons",
		"workspace"
	],
	"homepage": "https://github.com/trk/React",
	"authors": [
		{
			"name": "Iskender TOTOGLU",
			"email": "iskender@totoglu.com",
			"homepage": "https://totoglu.com/"
		}
	],
	"require": {
		"php": ">=8.4",
		"trk/processwire-inertia": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Totoglu\\React\\": "src/"
		}
	},
	"config": {
		"process-timeout": 0,
		"sort-packages": true,
		"allow-plugins": {
			"hari/pw-module": true
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
